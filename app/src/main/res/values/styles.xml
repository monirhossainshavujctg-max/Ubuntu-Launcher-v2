<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ubuntu" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">#E95420</item>
        <item name="android:windowBackground">#2C001E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#2C001E</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <style name="Quick">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_quick</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
